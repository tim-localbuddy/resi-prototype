rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // User can read/write their own user document
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // User can read documents if they have access to the document's property
    // We check if the document's `propertyId` exists as a key in the user's `properties` map.
    match /documents/{documentId} {
      allow read: if isAuthenticated() && 
        resource.data.propertyId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.properties;
    }

    // Issues rules
    match /issues/{issueId} {
      // Allow read if user is the creator OR their role on the issue's property is privileged
      allow read: if isAuthenticated() && (
        resource.data.loggedByUid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.properties[resource.data.property] in ['director', 'committee', 'agent']
      );
      // All writes must go through Cloud Functions
      allow write: if false;
    }
  }
}
